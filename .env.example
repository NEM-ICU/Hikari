# Supabase project settings (the anon key is safe to expose in browser code;
# row-level security in the migration protects each user's cards).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# AI provider settings (only needed for the provider you select).
HF_TOKEN=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
